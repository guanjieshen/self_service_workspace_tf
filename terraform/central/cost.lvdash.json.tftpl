          },
          {
           "name": "sum(cost)",
           "expression": "SUM(`cost`)"
          }
         ],
         "disaggregated": false
        }
       }
      ],
      "spec": {
       "version": 3,
       "widgetType": "bar",
       "encodings": {
        "x": {
         "fieldName": "usage_policy",
         "scale": {
          "type": "categorical",
          "sort": {
