{
 "datasets": [
  {
   "name": "ds_cost",
   "displayName": "Cost by day",
   "queryLines": [
    "SELECT usage_date, month, workspace, usage_policy, project, product, sum(dbus) AS dbus, sum(cost) AS cost FROM ${view} WHERE usage_date >= add_months(date_trunc('MONTH', current_date()), -5) GROUP BY usage_date, month, workspace, usage_policy, project, product"
   ]
  },
  {
   "name": "ds_months",
   "displayName": "This month and last",
   "queryLines": [
    "SELECT workspace, sum(CASE WHEN month = date_trunc('MONTH', current_date()) THEN cost ELSE 0 END) AS this_month, sum(CASE WHEN month = add_months(date_trunc('MONTH', current_date()), -1) THEN cost ELSE 0 END) AS last_month, sum(CASE WHEN month = date_trunc('MONTH', current_date()) THEN dbus ELSE 0 END) AS this_month_dbus FROM ${view} WHERE usage_date >= add_months(date_trunc('MONTH', current_date()), -1) GROUP BY workspace"
   ]
  },
  {
   "name": "ds_mine",
   "displayName": "My usage",
   "queryLines": [
    "SELECT usage_date, workspace, product, sum(dbus) AS dbus, sum(cost) AS cost FROM ${view} WHERE run_as = current_user() AND usage_date >= add_months(date_trunc('MONTH', current_date()), -5) GROUP BY usage_date, workspace, product"
   ]
  }
 ],
 "pages": [
  {
   "name": "overview",
   "displayName": "Overview",
   "pageType": "PAGE_TYPE_CANVAS",
   "layout": [
    {
     "widget": {
      "name": "ov_title",
      "multilineTextboxSpec": {
       "lines": [
        "## What your workspaces cost"
       ]
      }
     },
     "position": {
      "x": 0,
      "y": 0,
      "width": 6,
      "height": 1
     }
    },
    {
     "widget": {
      "name": "ov_note",
      "multilineTextboxSpec": {
       "lines": [
        "*Estimated cost: list price less your organization's negotiated discount (${discount}%). DBUs are Databricks' unit of compute. Usage policies tag usage; they do not cap it. You see only the workspaces you belong to.*"
       ]
      }
     },
     "position": {
      "x": 0,
      "y": 1,
      "width": 6,
      "height": 1
     }
    },
    {
     "widget": {
      "name": "ov_this_month",
      "queries": [
       {
        "name": "main_query",
        "query": {
         "datasetName": "ds_months",
         "fields": [
          {
           "name": "sum(this_month)",
           "expression": "SUM(`this_month`)"
          }
         ],
         "disaggregated": false
        }
       }
      ],
      "spec": {
       "version": 2,
       "widgetType": "counter",
       "encodings": {
        "value": {
         "fieldName": "sum(this_month)",
         "displayName": "Estimated cost this month ($)"
        }
       },
       "frame": {
        "showTitle": true,
        "title": "Estimated cost this month ($)"
       }
      }
     },
     "position": {
      "x": 0,
      "y": 2,
      "width": 2,
      "height": 3
     }
    },
    {
     "widget": {
      "name": "ov_last_month",
      "queries": [
       {
        "name": "main_query",
        "query": {
         "datasetName": "ds_months",
         "fields": [
          {
           "name": "sum(last_month)",
           "expression": "SUM(`last_month`)"
          }
         ],
         "disaggregated": false
        }
       }
      ],
      "spec": {
       "version": 2,
       "widgetType": "counter",
       "encodings": {
        "value": {
         "fieldName": "sum(last_month)",
         "displayName": "Last month ($)"
        }
       },
       "frame": {
        "showTitle": true,
        "title": "Last month ($)"
       }
      }
     },
     "position": {
      "x": 2,
      "y": 2,
      "width": 2,
      "height": 3
     }
    },
    {
     "widget": {
      "name": "ov_dbus",
      "queries": [
       {
        "name": "main_query",
        "query": {
         "datasetName": "ds_months",
         "fields": [
          {
           "name": "sum(this_month_dbus)",
           "expression": "SUM(`this_month_dbus`)"
          }
         ],
         "disaggregated": false
        }
       }
      ],
      "spec": {
       "version": 2,
       "widgetType": "counter",
       "encodings": {
        "value": {
         "fieldName": "sum(this_month_dbus)",
         "displayName": "DBUs this month"
        }
       },
       "frame": {
        "showTitle": true,
        "title": "DBUs this month"
       }
      }
     },
     "position": {
      "x": 4,
      "y": 2,
      "width": 2,
      "height": 3
     }
    },
    {
     "widget": {
      "name": "ov_by_month",
      "queries": [
       {
        "name": "main_query",
        "query": {
         "datasetName": "ds_cost",
         "fields": [
          {
           "name": "monthly(usage_date)",
           "expression": "DATE_TRUNC(\"MONTH\", `usage_date`)"
          },
          {
           "name": "sum(cost)",
           "expression": "SUM(`cost`)"
          },
          {
           "name": "product",
           "expression": "`product`"
          }
         ],
         "disaggregated": false
        }
       }
      ],
      "spec": {
       "version": 3,
       "widgetType": "bar",
       "encodings": {
        "x": {
         "fieldName": "monthly(usage_date)",
         "scale": {
          "type": "temporal"
         },
         "displayName": "Month"
        },
        "y": {
         "fieldName": "sum(cost)",
         "scale": {
          "type": "quantitative"
         },
         "displayName": "Estimated cost ($)"
        },
        "color": {
         "fieldName": "product",
         "scale": {
          "type": "categorical"
         },
         "displayName": "Product"
        }
       },
       "frame": {
        "showTitle": true,
        "title": "Cost by month, by product"
       }
      }
     },
     "position": {
      "x": 0,
      "y": 5,
      "width": 3,
      "height": 6
     }
    },
    {
     "widget": {
