WITH
  workspaces (workspace_id, workspace) AS (VALUES ${workspaces}),
  access (workspace_id, group_name) AS (VALUES ${access}),
  policies (policy_id, policy_name) AS (VALUES ${policies}),
  -- Whether the viewer is a platform admin of each workspace: they see who ran what there.
  admins (workspace_id, group_name) AS (VALUES ${admins}),
  viewer_admin AS (SELECT workspace_id, max(is_account_group_member(group_name)) AS is_admin FROM admins GROUP BY workspace_id)
SELECT
  u.usage_date,
  DATE_TRUNC('MONTH', u.usage_date) AS month,
  w.workspace,
  coalesce(pn.policy_name,
           CASE WHEN coalesce(u.usage_metadata.usage_policy_id, u.usage_metadata.budget_policy_id) IS NULL
                THEN 'No usage policy' ELSE 'Another usage policy' END) AS usage_policy,
  coalesce(u.custom_tags['APPID'], 'Not set') AS project,
  CASE
    WHEN u.billing_origin_product = 'INTERACTIVE' AND u.product_features.is_serverless THEN 'Serverless notebooks'
    WHEN u.billing_origin_product IN ('INTERACTIVE', 'ALL_PURPOSE') THEN 'Notebooks on clusters'
    WHEN u.billing_origin_product = 'GENIE' THEN 'Genie'
    WHEN u.billing_origin_product = 'JOBS' THEN 'Jobs'
    WHEN u.billing_origin_product = 'DLT' THEN 'Pipelines'
    WHEN u.billing_origin_product = 'SQL' THEN 'SQL warehouses'
    WHEN u.billing_origin_product IN ('MODEL_SERVING', 'AI_GATEWAY', 'AI_FUNCTIONS', 'VECTOR_SEARCH', 'AGENT_BRICKS') THEN 'AI and model serving'
    WHEN u.billing_origin_product = 'LAKEFLOW_CONNECT' THEN 'Ingestion'
    WHEN u.billing_origin_product = 'APPS' THEN 'Apps'
    WHEN u.billing_origin_product = 'LAKEBASE' THEN 'Lakebase'
    ELSE 'Other'
  END AS product,
  -- A person's own usage: serverless notebooks, Genie, and jobs and pipelines that ran as them.
  -- Shared compute (warehouses, apps, serving, clusters) is charged to the resource, not a
  -- person, so it counts only in the workspace's totals.
  (u.identity_metadata.run_as LIKE '%@%'
   AND ((u.billing_origin_product = 'INTERACTIVE' AND u.product_features.is_serverless)
        OR u.billing_origin_product IN ('GENIE', 'JOBS', 'DLT'))) AS personal,
  -- Who ran it: on the viewer's own rows, or anywhere in a workspace they are platform admin of.
  CASE WHEN u.identity_metadata.run_as = current_user() OR va.is_admin THEN u.identity_metadata.run_as END AS run_as,
  CASE WHEN u.usage_unit = 'DBU' THEN u.usage_quantity ELSE 0 END AS dbus,
  u.usage_quantity * coalesce(p.pricing.effective_list.default, 0) AS list_cost,
  u.usage_quantity * coalesce(p.pricing.effective_list.default, 0) * (1 - ${discount} / 100) AS cost
FROM system.billing.usage u
JOIN workspaces w ON u.workspace_id = w.workspace_id
LEFT JOIN viewer_admin va ON va.workspace_id = u.workspace_id
LEFT JOIN system.billing.list_prices p
  ON u.sku_name = p.sku_name AND u.cloud = p.cloud AND u.usage_unit = p.usage_unit
 AND u.usage_end_time >= p.price_start_time AND (p.price_end_time IS NULL OR u.usage_end_time < p.price_end_time)
LEFT JOIN policies pn ON pn.policy_id = coalesce(u.usage_metadata.usage_policy_id, u.usage_metadata.budget_policy_id)
-- Each viewer sees only the workspaces whose groups they are in (evaluated as the viewer).
WHERE EXISTS (SELECT 1 FROM access a WHERE a.workspace_id = u.workspace_id AND is_account_group_member(a.group_name))
